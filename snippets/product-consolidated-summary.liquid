{%- comment -%}
  Renders description summary text consolidated from the blank and design metadata attached to a product, and the product_summary itself

  Accepts:
      nothing
  Usage:
  {%- render 'product-consolidated-summary' -%}

  Author:
  FullChestCovers
  
{%- endcomment -%}
{%- comment -%}
The summaries are displayed in order from most specific (product) to least specific (blank)
{%- endcomment -%}
{%- capture consolidated_summary -%}
  {{ product.metafields.custom.product_summary.value }}
  {{ product.metafields.custom.product_design.value.description.value }}
  {{ product.metafields.custom.product_blank.value.product_description_summary.value }}
{%- endcapture -%}
{%- if consolidated_summary != empty and consolidated_summary != blank -%}
  {{ consolidated_summary }}
{%- endif -%}
 