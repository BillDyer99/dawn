
{% assign stripped_layout = layout | strip %}
{% assign stripped_text_only_all_items = text_only_all_items | strip %}

{%- if stripped_layout  == "" -%}
    {%- assign layout = "vertical" -%}
{%- endif -%}
{%- if stripped_text_only_all_items == "" -%}
    {%- assign text_only_all_items = "false" -%}
{%- endif -%}

<ul
  class="icon-with-text icon-with-text--{{ layout }} list-unstyled{% if text_only_all_items %} icon-with-text--text-only{% endif %}"
  {{ shopify_attributes }}
>