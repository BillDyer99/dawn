{% comment %}
  Renders the correct product size chart url for the current product.

  Accepts:
      Nothing
      
  Usage:
      {% render 'product-size-chart-link' %}

  Author:
      FullChestCovers
  
{% endcomment %}
{%- if product.tags contains 'Men'  -%}
    {{ product.metafields.custom.product_blank.value.urls.value.mens_size_chart.value }}
{%- elsif product.tags contains 'Youth' -%}
    {{ product.metafields.custom.product_blank.value.urls.value.youth_size_chart.value }}
{%- elsif product.tags contains 'Women' -%} 
    {{ product.metafields.custom.product_blank.value.urls.value.womens_size_chart.value }}
{%- else -%}
  {{  }}
{%- endif -%}
    

