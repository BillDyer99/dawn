{%- comment -%}
  Renders feature text consolidated from the blank and design metadata attached to a product, and the features for the product.

  Accepts:
      nothing
  Usage:
  {%- render 'product-consolidated-features' -%}

  Author:
  FullChestCovers
  
{%- endcomment -%}
{%- comment -%}
The features are displayed in order from most specific (design) to least specific (blank)
{%- endcomment -%}
{%- capture consolidated_features -%}
  {{ product.metafields.custom.product_features.value }}
  {{ product.metafields.custom.product_design.value.features.value }}
  {{ product.metafields.custom.product_blank.value.product_features.value }}
{%- endcapture -%}
{%- if consolidated_features != empty and consolidated_features != blank -%}
  {{ consolidated_features }}
{%- endif -%}
 