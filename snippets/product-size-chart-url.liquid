{% comment %}
  Renders the correct product size chart url for the current product.

  Accepts:
      Nothing
      
  Usage:
      {% render 'product-size-chart-link' %}

  Author:
      FullChestCovers
  
{% endcomment %}
{%- if product.tags contains 'men'  -%}
    {{ product.custom.product_blank.urls.mens_size_chart }}
{%- elsif product.tags contains 'youth' -%}
    product.custom.product_blank.urls.youth_size_chart }}
{%- elsif product.tags contains 'women' -%} 
  {{ product.custom.product_blank.urls.womens_size_chart }}
{%- else -%}
  {{  }}
{%- endif -%}
    

